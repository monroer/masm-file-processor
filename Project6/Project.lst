				; ---------------------------------------------------------------------------------
				; Name: ParseTempsFromString
				;
				; Converts string temperature values to numeric values using string primitives.
				;
				; Preconditions: fileBuffer contains ASCII temperature values separated by DELIMITER
				;
				; Postconditions: none
				;
				; Receives:
				; [ebp+12] = reference to fileBuffer
				; [ebp+8] = reference to temperature array
				;
				; Returns: temperature array filled with converted values
				; ---------------------------------------------------------------------------------

 000000F7			ParseTempsFromString PROC
					LOCAL currentTemp:sdword
					LOCAL isNegative:byte

 000000F7  55		   *	    push   ebp
 000000F8  8B EC	   *	    mov    ebp, esp
 000000FA  83 C4 F8	   *	    add    esp, 0FFFFFFF8h
 000000FD  55				push		ebp
 000000FE  8B EC			mov			ebp, esp
 00000100  60				pushad								; save all registers

					; set up source and destination pointers
 00000101  8B 75 0C			mov			esi, [ebp+12]			; fileBuffer source
 00000104  8B 7D 08			mov			edi, [ebp+8]			; temperature array destination
 00000107  33 C9			xor			ecx, ecx

 00000109			_parseNextTemp:
					;check if reached max number of temps
 00000109  83 F9 18			cmp			ecx, TEMPS_PER_DAY
 0000010C  73 6B			jae			_doneParsing

					; initialize for new temp
 0000010E  C7 45 FC			mov			currentTemp, 0			; reset current temp value
	   00000000
 00000115  C6 45 FB 00			mov			isNegative, 0			; reset negative flag

 00000119  AC				lodsb

					; skip leading whitespace and check for end of file
 0000011A  3C 20			cmp			al, ' '					; check for space
 0000011C  74 EB			je			_parseNextTemp			
 0000011E  3C 09			cmp			al, 9					; chekc for tab
 00000120  74 E7			je			_parseNextTemp			
 00000122  3C 0D			cmp			al, 13					; check for carriage return
 00000124  74 E3			je			_parseNextTemp			
 00000126  3C 0A			cmp			al, 10					; check for line feed
 00000128  74 DF			je			_parseNextTemp			
					
					; check fior end of string
 0000012A  3C 00			cmp			al, 0
 0000012C  74 4B			je			_doneParsing

					
					; check for negative sign
 0000012E  3C 2D			cmp 		al, '-'					; see if negative
 00000130  75 05			jne			_notNegative			; if not check if digit
 00000132  C6 45 FB 01			mov			isNegative, 1			; set neg flag
 00000136  AC				lodsb

 00000137			_notNegative:
					;process digits

 00000137			_digitLoop:
 00000137  3C 30			cmp			al, '0'
 00000139  72 17			jb			_notDigit
 0000013B  3C 39			cmp			al, '9'
 0000013D  77 13			ja			_notDigit

					;convert ascii to numeric value
 0000013F  2C 30			sub			al, '0'					; convert ascii to numeric
 00000141  0F B6 C0			movzx		eax, al					; zero eztend al to eax

					; multiply current value by 10 and add new digit
 00000144  8B 5D FC			mov			ebx, currentTemp
 00000147  6B DB 0A			imul		ebx, 10
 0000014A  03 D8			add			ebx, eax
 0000014C  89 5D FC			mov			currentTemp, ebx

					; get next char
 0000014F  AC				lodsb
 00000150  EB E5			jmp			_digitLoop

 00000152			_notDigit:
					;apply sign in neg
 00000152  80 7D FB 00			cmp			isNegative, 0
 00000156  74 03			je			_storeTemp
 00000158  F7 5D FC			neg			currentTemp

 0000015B			_storeTemp:
					;store temp in array
 0000015B  8B 45 FC			mov			eax, currentTemp
 0000015E  89 07			mov			[edi], eax
 00000160  83 C7 04			add			edi, TYPE sdword		; move to next array element
 00000163  41				inc			ecx

					; check if current char is delimiter
 00000164  3C 2C			cmp			al, DELIMITER
 00000166  75 A1			jne			_parseNextTemp		; if not delimiter, may be end of data

					; check if end of string
 00000168  3C 00			cmp			al, 0				; check for end of string
 0000016A  74 0D			je			_doneParsing

 0000016C  EB 00			jmp			_skipToDelimiter


 0000016E			_skipToDelimiter:
					; skip to next delimiter or end of file
 0000016E  AC				lodsb
 0000016F  3C 00			cmp			al, 0					; check for end of file
 00000171  74 06			je			_doneParsing			; if end of file, done
 00000173  3C 2C			cmp			al ,DELIMITER			;check for delimiter
 00000175  75 F7			jne			_skipToDelimiter		; if not delimiter, go past

 00000177  EB 90			jmp			_parseNextTemp			; continue skipping

 00000179			_doneParsing:
 00000179  61				popad								; restore all registers
 0000017A  5D				pop			ebp
 0000017B  C9		   *	    leave  
 0000017C  C2 0008			ret			8						; clean up stack (2 * 4 bytes)

 0000017F			ParseTempsFromString ENDP


				; ---------------------------------------------------------------------------------
				; Name: WriteTempsReverse
				;
				; Prints the temperature values in reverse order.
				;
				; Preconditions: Temperature array contains valid temperature values
				;
				; Postconditions: none
				;
				; Receives:
				; [ebp+8] = reference to temperature array
				;
				; Returns: none
				; ---------------------------------------------------------------------------------

 0000017F			WriteTempsReverse PROC
 0000017F  55				push		ebp
 00000180  8B EC			mov			ebp, esp
 00000182  60				pushad								; save all registers

					; start from end of array
 00000183  8B 75 08			mov			esi, [ebp+8]			; get address of temp array
 00000186  B9 00000018			mov			ecx, TEMPS_PER_DAY		; set counter
 0000018B  B8 00000004			mov			eax, TYPE sdword		; size of each element
 00000190  F7 E1			mul			ecx						; calculate total array size
 00000192  49				dec			ecx						; adjust counter for 0 based indexing
 00000193  03 F0			add			esi, eax				; point to end of array
 00000195  83 EE 04			sub			esi, TYPE sdword		; point to last element

					; print temps in reverse order
 00000198			_printReverse:
					; print current temp
 00000198  8B 06			mov			eax, [esi]
 0000019A  E8 00000000 E		call		WriteInt

					; check if more temps
 0000019F  49				dec			ecx
 000001A0  7C 0E			jl			_DoneWriting

					; print delimiter and continue
					mDisplayCharacter DELIMITER
 000001A2  50		     1		push	eax						; save register
 000001A3  B0 2C	     1		mov		al, DELIMITER				; print character
 000001A5  E8 00000000 E     1		call	WriteChar
 000001AA  58		     1		pop		eax						; restore register
 000001AB  83 EE 04			sub			esi, TYPE sdword		; move to previous element
 000001AE  EB E8			jmp			_printReverse

 000001B0			_doneWriting:
 000001B0  E8 00000000 E		call		CrLf

 000001B5  61				popad								; restore all regiosters
 000001B6  5D				pop			ebp
 000001B7  C2 0004			ret			4						; clean up stack (1 * 4 bytes)

 000001BA			WriteTempsReverse ENDP


				END main
